# Backend environment variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- External API keys / URLs ---
# USGS earthquake feed does not require a key (public).
# USGS_FEED_URL is the base URL for the USGS GeoJSON feed.
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary

# Open-Meteo does not require an API key for the free tier.
OPEN_METEO_URL=https://api.open-meteo.com/v1

# --- Backend settings ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# DATABASE_URL=                  # OPEN: not yet decided — fill in when chosen
#   Example SQLite:  sqlite+aiosqlite:///./safegrid.db
#   Example Postgres: postgresql+asyncpg://user:password@localhost/safegrid

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
